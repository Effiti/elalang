{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "ela",
      "camelcase": "Ela",
      "title": "Ela",
      "scope": "source.ela",
      "path": ".",
      "file-types": [
        "ela"
      ],
      "highlights": [
        "queries/highlights.scm"
      ],
      "injection-regex": "^ela$",
      "class-name": "TreeSitterEla"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "Apache 2.0",
    "description": "A tree-sitter grammar for the Ela language",
    "authors": [
      {
        "name": "Effiti"
      }
    ],
    "links": {
      "repository": "https://github.com/Effiti/elalang"
    }
  },
  "bindings": {
    "c": true,
    "go": true,
    "node": true,
    "python": true,
    "rust": true,
    "swift": true,
    "zig": false
  }
}
